# Plantilla de configuración. Copiar a .env; no guardar secretos en este archivo.
APP_NAME="Vehículo IoT API"
# development para desarrollo local; production para el servidor EC2.
APP_ENV=development

# Simulación de turnos. Activar ambos flags solo en desarrollo local.
CONTROL_PUBLICO_ENABLED=false
CONTROL_PUBLICO_SIMULATION=false
# CONTROL_PUBLICO_SQLITE_PATH=C:\ruta-privada-fuera-del-repositorio\control.sqlite3
# CONTROL_PUBLICO_VEHICLE_IDS=[1]
# CONTROL_PUBLICO_RATE_PER_SECOND=5
# CONTROL_PUBLICO_TURN_SECONDS=120
# CONTROL_PUBLICO_INACTIVITY_SECONDS=20

# Reemplazar sólo en .env con una clave aleatoria. Este ejemplo no autoriza.
API_KEY=change-me

# Completar estos valores únicamente en .env con los datos reales de RDS.
DB_HOST=
DB_PORT=3306
DB_NAME=vehiculo_iot
DB_USER=
DB_PASSWORD=

# CA pública oficial de Amazon RDS. Las rutas relativas parten de este proyecto.
# Descargar el bundle siguiendo README.md; no contiene claves ni credenciales.
DB_SSL_CA=.certs/rds-global-bundle.pem

# Tiempos máximos en segundos. Se aplican valores predeterminados si se omiten.
DB_CONNECT_TIMEOUT=5
DB_READ_TIMEOUT=10
DB_WRITE_TIMEOUT=10
