# Configuración local. Copiar a .env; no guardar secretos en este archivo.
APP_NAME="Vehículo IoT API"
APP_ENV=development

# RDS se configurará y verificará en una etapa posterior.
# Completar estos valores únicamente en .env con los datos reales de RDS.
DB_HOST=
DB_PORT=3306
DB_NAME=vehiculo_iot
